<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        The sample job application seeded by changeset 015 (context
        dev,demo) originally stored an external link
        ("https://drive.google.com/...") in resume_path, from before
        resume_path meant "filename on this server's disk". Under the
        new scheme that string is not a real file and would 404 on
        GET /api/v1/job-applications/1/resume, so this clears it —
        the seeded application still displays fine in the admin
        console, it simply shows "No resume uploaded" instead of a
        stale, unusable link.
    -->
    <changeSet id="017-clear-legacy-resume-link-seed" author="seashine-marine" context="dev,demo">
        <update tableName="job_applications">
            <column name="resume_path" value="NULL"/>
            <where>applicant_name = 'Rahul Sharma' AND resume_path = 'https://drive.google.com/sample-resume-1'</where>
        </update>
    </changeSet>

</databaseChangeLog>
