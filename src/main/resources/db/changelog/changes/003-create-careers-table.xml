<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Full CRUD via CareerRepositoryImpl / CareerRowMapper. -->
    <changeSet id="003-create-careers-table" author="seashine-marine">
        <createTable tableName="careers">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="job_title" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="department" type="VARCHAR(100)"/>
            <column name="location" type="VARCHAR(100)"/>
            <column name="experience_required" type="VARCHAR(50)"/>
            <column name="employment_type" type="VARCHAR(50)"/>
            <column name="description" type="TEXT"/>
            <column name="status" type="VARCHAR(20)" defaultValue="OPEN">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="INT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="careers" baseColumnNames="created_by"
                referencedTableName="admin_users" referencedColumnNames="id"
                constraintName="fk_careers_created_by"
                onDelete="SET NULL"/>

        <createIndex tableName="careers" indexName="idx_careers_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
