        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Seed data so both Angular apps have something to show on first
        run. runOnChange="false" (the default) means this only runs
        once — safe to leave in place permanently.
    -->
    <changeSet id="011-seed-admin-user" author="seashine-marine" context="dev,demo">
        <!--
            NOTE: AuthServiceImpl currently compares passwords with a
            plain String.equals() (no hashing), so this seed password
            is plain text to match. Hash passwords (e.g. BCrypt) before
            any real deployment and update AuthServiceImpl accordingly.
        -->
        <insert tableName="admin_users">
            <column name="username" value="admin"/>
            <column name="password" value="admin123"/>
            <column name="full_name" value="Site Administrator"/>
            <column name="email" value="admin@seashinemarine.com"/>
            <column name="role" value="ADMIN"/>
            <column name="status" value="ACTIVE"/>
        </insert>
    </changeSet>

