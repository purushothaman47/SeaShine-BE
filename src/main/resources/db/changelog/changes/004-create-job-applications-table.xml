<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Created (POST) publicly; listed/viewed/deleted by admins via
        JobApplicationRepositoryImpl / JobApplicationRowMapper.
        application_status is always forced to 'PENDING' by the
        backend on insert, regardless of what the client sends.
    -->
    <changeSet id="004-create-job-applications-table" author="seashine-marine">
        <createTable tableName="job_applications">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="career_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="applicant_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(100)"/>
            <column name="phone" type="VARCHAR(20)"/>
            <column name="resume_path" type="VARCHAR(255)"/>
            <column name="cover_letter" type="TEXT"/>
            <column name="application_status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="applied_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="job_applications" baseColumnNames="career_id"
                referencedTableName="careers" referencedColumnNames="id"
                constraintName="fk_applications_career"
                onDelete="CASCADE"/>

        <createIndex tableName="job_applications" indexName="idx_applications_career_id">
            <column name="career_id"/>
        </createIndex>
        <createIndex tableName="job_applications" indexName="idx_applications_status">
            <column name="application_status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
